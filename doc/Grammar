-- All "list-<R>" rules are defined as "<R> { ',' <R> }", that is,
-- comma separated list of at least one <R>

module :=		{ module-import | class-def | iface-def | extend-def |
				foreign-def }

module-path ::=	{ Name ':' } Name

module-import ::= 'import' module-path

item-name ::=	[ module-path ':' ] Name

class-def :=	( 'object' | 'value' )
				Name
				[ template-def ]
				class-body
				'end'

iface-def :=	'interface' Name [ template-def ]
				{ prototype | 'embed' full-ident }
				'end'

extend-def :=	'extend' ( Name template-def | full-ident )
				{ method-def }
				'end'

foreign-def :=	'foreign' Name
				{ prototype }
				'end'

-- This rule is used for class names, methods and members, locals, foreign
-- functions, etc. Often, only analysis can make the distinction.

full-ident :=	Name { ':' Name } [ class-params ] | '#' full-ident

class-params :=	'|' ( full-ident | '(' list-full-ident ')' )

template-def :=	'|' '(' list-class-param-def ')'

class-param-def :=	full-ident Name

type :=			full-ident [ '?' ]

class-body :=	{ member-def | method-def | ctor-def }

member-def :=	( type Name | 'embed' full-ident ) [ '=' exp ]

method-def :=	'method'
				prototype
				block
				'end'

prototype :=	[ list-type ] method-name '(' [ list-arg-def ] ')'

method-name :=	Name [ '=' ] |
				binop | 
				'[' ']' [ '=' ]

binop :=		'+' | '-' | '*' | '/' | '%' |
				'<' | '>' | '<=' | '>=' | '^' |
				'~' | '==' | '~=' | 'and' |
				'or' | 'is' | 'isnot'

arg-def :=		type [ Name ]

ctor-def :=		'new' [ list-type ] '(' [ list-arg-def ] ')'
				block
				'end'

block :=		{ statement }
				[ final-statement ]

statement :=	do-stat |
				while-stat |
				for-stat |
				if-stat |
				local-decl |
				assignment |
				call-stat

final-statement :=	'break' | 'continue' | 'return' [ list-exp ]

do-stat :=		'do' block 'end'

while-stat :=	'while' exp [ 'as' Name ] 'do' block 'end'

for-stat :=		'for' list-name 'in' list-exp 'do' block 'end'

if-stat :=		'if' exp [ 'as' Name ] 'then' block
				{ 'elseif' exp [ 'as' Name ] 'then' block }
				[ 'else' block ]
				'end'

local-decl :=	'local' list-name '=' list-exp

assignment :=	list-left-value '=' list-exp

exp :=			term { binop term } [ 'to' full-ident ]

term :=			basic-exp | ( '-' | 'not' ) term

basic-exp :=	( literal-exp | array-table-cons | '(' exp ')' | full-ident )
				exp-tail

literal-exp :=	Number | String | 'true' | 'false' | 'nil' | 'self'

array-table-cons :=	'{' [ list-exp ] | [ list-table-cons-pair ] '}'

table-cons-pair :=	exp '=' exp

exp-tail :=		{ '[' [ list-exp ] ']' | '.' full-ident | call-arg }	### no consecutive call-args

call-arg :=		'(' [ list-exp ] ')' | array-table-cons | String

call-stat :=	( 'self' | full-ident ) exp-tail

left-value :=	call-stat	### no final call-arg
