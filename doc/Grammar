chunk := 		block |
				{ class }
			
class :=		'class' ClassName [ ':' ClassName ]
				{ [ 'private' ] type Name }
				[ 'methods' { method } ]
				'end'
				
method :=		[ 'private' ] [ type { ',' type } ]
				( Name | 'op' Binop )
				'(' [ type Name { ',' type Name } ] ')'
				block
				'end'

type :=			'num' | 'vec' | 'str' |
				ClassName |
				'[' type ']' |
				'/' type '/' |
				'{' { type  [ ',' ] } '}'

block :=		{ stat [ ';' ] }
				[ break | continue | return [ listexp ] ]

stat :=			'do' block 'end' |
				'while' exp 'dö́' block 'end' |
				'if' exp 'then' block
					{ 'elseif' exp 'then' block }
					[ 'else' block ]
				'end' |
				'for' Name '=' exp ',' exp [ ',' exp ] 'do' block 'end' |
				'for' Name { ',' Name } 'in' exp 'do' block 'end' |
				exp |
				listbasicexp '=' listexp

atomicexp :=	Name | Number | String | 'nil' | 'false' | 'true' |
				Symbol | '(' exp ')' |
				'{' [ listbasicexp ] '}' |
				'[' [ listbasicexp ] ']' |
				'/' [ listbasicexp ] '/' |
				'<' [ listbasicexp ] '>' |
				ClassName [ '(' [ listexp ] ')' ]

exptail :=		'.' Name |
				'(' [ listexp ] ')' |
				'[' exp ']'

basicexp :=		[ Unop ] atomicexp { exptail }

exp := 			basicexp { Binop basicexp }

listexp :=		exp { ',' exp }

listbasicexp :=	basicexp { ',' basicexp }

methodcall :=	basicexp (with a 'call' as top node)
