-- All "list-<R>" rules are defined as "<R> { ',' <R> }", that is, comma separated list of at least one <R>

chunk :=		{ class-def | iface-def }

class-def :=	( 'object' | 'value' | 'extend' )
				CName
				[ template-def ]
				class-body
				'end'

iface-def :=	'interface' CName [ template-def ]
				{ method-proto | 'embed' list-class-name }
				'end'

class-name :=	( ( CName | 'num' | 'bool' | 'text' | 'blob' | 'data' )
				[ type-params ] ) |
				'#' class-name

type-params := 	'|' ( class-name | '(' list-class-name ')' )

template-def :=	'|' '(' list-type-param-def ')'

type-param-def :=	CName CName

type :=			class-name [ '?' ]

class-body :=	{ member-def | method-def | foreign-def |
				'embed' list-class-name }

member-def :=	type Name
				[ '=' exp ]

method-def :=	( 'method' | 'selfless' )
				method-proto
				block
				'end'

foreign-def :=	'foreign' method-proto

method-proto :=	[ list-type ] method-name '(' [ list-arg-def ] ')'

method-name :=	Name [ '=' ] |
				binop | 
				'[' ']' [ '=' ]

binop :=		'+' | '-' | '*' | '/' | '%' |
				'<' | '>' | '<=' | '>=' | '^' |
				'~' | '<~' | '==' | '~=' | 'and' |
				'or' | 'is' | 'isnot'

arg-def :=		type [ Name ]

block :=		{ statement }
				[ final-statement ]

statement :=	do-stat |
				while-stat |
				for-stat |
				if-stat |
				assignment |
				call-stat

final-statement :=	'break' | 'continue' | 'return' [ list-exp ]

do-stat :=		'do' block 'end'

while-stat :=	'while' exp [ 'as' Name ] 'do' block 'end'

for-stat :=		'for' list-name 'in' list-exp 'do' block 'end'

if-stat :=		'if' exp [ 'as' Name ] 'then' block
				{ 'elseif' exp [ 'as' Name ] 'then' block }
				[ 'else' block ]
				'end'

assignment :=	list-left-value '=' list-exp

left-value :=	[ class-name ':' ] Name [ [ call-arg ] { exp-tail } ( indexing | '.' Name | '.' class-name ) ]

call-stat :=	method-call { exp-tail }

method-call :=	[ class-name ':' ] Name [ call-arg ]

exp :=			term { binop term }

term :=			unary-op | typecast | basic-exp

unary-op :=		( '-' | 'not' ) term

typecast :=		basic-exp 'to' class-name

basic-exp :=	( atomic-exp | method-call | vec-cons | array-cons |
				table-cons | object-cons | '(' exp ')' )
				{ exp-tail }

atomic-exp :=	Name | Number | String | 'true' | 'false' | 'nil'
				'self'

vec-cons :=		'<' list-basic-exp '>'

array-cons :=	'[' [ list-exp ] ']'

table-cons :=	'{' [ list-table-cons-pair ] '}'

table-cons-pair :=	exp ':' exp

object-cons :=	class-name [ array-cons | table-cons | with-cons | call-arg ]

with-cons :=	'(' list-with-cons-pair ')'

with-cons-pair :=	( Name | class-name ) '=' exp

call-arg	:=	'(' [ list-exp ] ')' | String

exp-tail :=		indexing | message-sending

indexing :=		'[' list-exp ']'

message-sending := 	'.' ( Name [ call-arg ] | class-name )
