chunk := 		block |
				{ class }
			
class :=		'class' ClassName [ ':' ClassName ]
				{ [ 'private' ] type Name }
				[ 'methods' { method } ]
				'end'
				
method :=		[ 'private' ] [ type { ',' type } ]
				Name
				'(' { type Name [ ',' ] } ')'
				block
				'end'

type :=			'num' | 'vec' | 'str' |
				ClassName |
				'[' type ']' |
				'/' type '/' |
				'{' { type  [ ',' ] } '}'

block :=		{ stat [ ';' ] }
				[ break | continue | return { exp [ ',' ] } ]

stat :=			'do' block 'end' |
				'while' exp 'dö́' block 'end' |
				'if' exp 'then' block
					{ 'elseif' exp 'then' block }
					[ 'else' block ]
				'end' |
				'for' Name '=' exp ',' exp [ ',' exp ] 'do' block 'end' |
				'for' Name { [ ',' ] Name } 'in' exp 'do' block 'end'
