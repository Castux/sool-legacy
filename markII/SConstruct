env = Environment()

env['CXX'] = 'clang++'
env.Append(CXXFLAGS = ['-Wall','-fcolor-diagnostics'])

btype = ARGUMENTS.get('build','debug')  # Defaults to debug

if btype == 'debug':
	env.Append(CXXFLAGS = '-g')
elif btype == 'release':
	env.Append(CXXFLAGS = ['-O3','-flto'])
	env.Append(LINKFLAGS = ['-flto','-fuse-linker-plugin','-s'])

print("Build type: " + btype)

sources = Glob("*.cpp")

env.Program(target = 'test', source = sources)
