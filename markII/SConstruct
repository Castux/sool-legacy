env = Environment()

cc = ARGUMENTS.get('cc','clang++')
if cc == 'clang++':
	env['CXX'] = 'clang++'
	env.Append(CXXFLAGS = ['-Wall','-fcolor-diagnostics'])
elif cc == 'g++':
	env['CXX'] = 'g++'
	env.Append(CXXFLAGS = ['-Wall'])

btype = ARGUMENTS.get('build','debug')  # Defaults to debug
if btype == 'debug':
	env.Append(CXXFLAGS = '-g')
elif btype == 'release':
	env.Append(CXXFLAGS = ['-O3'])
	env.Append(LINKFLAGS = ['-s'])

print("Build type: " + btype)

sources = Glob("*.cpp")

env.Program(target = 'test', source = sources)
