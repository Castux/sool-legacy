class Blah : Root
    
    num i
    vec v
    
    private num priv

methods
    
    num,num getSomething(vec v) -- haha local variable shadows member! bad!
        return v.x, v.y
    end
    
    num getPriv()
        return priv
    end
    
    private voidfunc()
        -- do things
    end
end

class Root methods    -- meh, not so nice
num main([str])
    
    a = Blah()
    
    x,y = a.getSomething(<5,10>)
    
    priv = getPriv a
    priv = a.getPriv() -- same thing!
    
    a,b = <1,3,4>,<2,4,5>
    
    c = a x b -- cross product ~ c = a.x(b)
    c = a * b -- dot product
    
    d = [1,2,3,a*b] -- array
    
    e = {1,Blah(),<3,4,5>}  -- pack
    
    somenum = 5.+(4) -- blah
    somenum = 5 + 4  -- better
    
    n = ++ 2
    n += 3 -- n.+=(3)
    
    for i,v in d do
        print v     -- v.print()
    end
    
    return x*y
end
end
