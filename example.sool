	end
end

class Root methods	-- meh, not so nice
num main([str])
	
	a = Blah()
	
	x,y = a.getSomething(<5,10>)
	
	priv = a.getPriv()
	
	a,b = <1,3,4>,<2,4,5>
	
	c = a * b -- dot product
	
	d = [1,2,3,a] -- array
	
	l = /1,2,3,4/	-- list
		   
	e = {1,Blah(),<3,4,5>}  -- pack
	
	somenum = 5 + 4		-- 5.+(4)
	
	n += 3 -- n.+=(3)
	
	for i,v in d do
		print "#i,#v"	 -- Root:print("%s,%s".format(i.to_s(),v.to_s()))
	end					  -- Or something like that
	
	
	return x*y
end
end
