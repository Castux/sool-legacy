class Blah : Root
	
	num i
	vec v
	{num vec} somePack
	str s
	
	[num] someArray
	[[num]] grid
	/Blah/ someList
	[/vec/] hum
	
	private num priv

methods
	
	num,num getSomething(vec v) -- haha local variable shadows member! bad!
		return v.x, v.y
	end
	
	num getPriv()
		return priv
	end
	
	private voidfunc()
