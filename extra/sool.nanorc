syntax "sool" ".*\.sool$"

# Keywords
color brightblue "\<(and|break|do|else|elseif|end|false|for|if|in|nil|not|or|return|then|true|while|as|class|meth|private|op|skip)\>"

# Known functions
color magenta "\<(init|index)\>"

# Types
color cyan "\<(str|num|vec|sym)\>"

# Numbers
color cyan "\<[0-9]+(\.[0-9]+)?([eE][0-9]+)?"
color cyan "0x[0-9a-fA-F]+"

# Strings and symbols
color green "\"(\\.|[^\\\"])*\""
color cyan "'(\\.|[^\\'])*'"

# Simple comments
color brightblack        "\-\-.*$"
