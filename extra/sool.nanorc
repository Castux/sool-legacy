syntax "sool" ".*\.sool$"

# Keywords
color brightblue "\<(object|value|extend|shared|internal|method|selfless|foreign|break|continue|return|do|while|if|then|elseif|else|as|not|to|and|or|is|isnot|true|false|nil|self|super|with|end)\>"

# Known functions
color magenta "\<(init)\>"

# Types
color cyan "\<(num|bool|text|data|blob)\>"

# Numbers
color cyan "\<[0-9]+(\.[0-9]+)?([eE][0-9]+)?"
color cyan "0x[0-9a-fA-F]+"

# Strings and symbols
color green "\"(\\.|[^\\\"])*\""
color cyan "'(\\.|[^\\'])*'"

# Simple comments
color brightblack        "\-\-.*$"
