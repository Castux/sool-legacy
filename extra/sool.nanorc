syntax "sool" ".*\.sool$"

# Keywords
color brightblue "\<(object|value|extend|interface|shared|method|selfless|foreign|embed|break|continue|return|do|for|while|if|then|elseif|else|in|as|not|to|and|or|is|isnot|true|false|nil|self|super|with|end)\>"

# Known functions
color magenta "\<(new)\>"

# Types
color cyan "\<(num|bool|text|data|blob)\>"

# Numbers
color cyan "\<[0-9]+(\.[0-9]+)?([eE][0-9]+)?"
color cyan "0x[0-9a-fA-F]+"

# Strings and symbols
color green "\"(\\.|[^\\\"])*\""
color cyan "'(\\.|[^\\'])*'"

# Simple comments
color brightblack        "\-\-.*$"
